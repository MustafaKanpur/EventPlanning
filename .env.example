# ─── Database (hosted Postgres: Neon or Supabase) ───
# Neon: use the pooled connection string; add ?sslmode=require
#
# Supabase: the "direct connection" host (db.<ref>.supabase.co) is IPv6-only and will
# fail with P1001 on IPv4-only networks. Use the Supavisor pooler instead:
#   DATABASE_URL = transaction pooler, port 6543, ?pgbouncer=true (Prisma Client at runtime)
#   DIRECT_URL   = session pooler, port 5432, same host             (prisma migrate)
# Both found under Project Settings → Database → Connection string → Connection pooling.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ─── NextAuth ───
NEXTAUTH_URL="http://localhost:3000"
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=""

# ─── Google OAuth (Google Cloud Console → Credentials → OAuth client, Web) ───
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Email magic links (SMTP) ───
# Dev without SMTP: leave blank — the sign-in link prints to the server console.
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="Event Planning <no-reply@example.org>"
